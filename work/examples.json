[{"category": "基本", "title": ".", "description": "入力値をそのまま出力します。", "filter": ".", "input": "{\"foo\":1}", "output": "{\"foo\":1}\n", "mode": "json", "flags": ["-c"]}, {"category": "基本", "title": ".foo", "description": "オブジェクトのキーfooを参照します。", "filter": ".foo", "input": "{\"foo\":42}", "output": "42\n", "mode": "json", "flags": ["-c"]}, {"category": "基本", "title": ".foo.bar", "description": "入れ子のオブジェクトを参照します。", "filter": ".foo.bar", "input": "{\"foo\":{\"bar\":\"こんにちは\"}}", "output": "\"こんにちは\"\n", "mode": "json", "flags": ["-c"]}, {"category": "基本", "title": ".[0]", "description": "配列の先頭要素。添字は0から始まります。", "filter": ".[0]", "input": "[10,20]", "output": "10\n", "mode": "json", "flags": ["-c"]}, {"category": "基本", "title": ".[]", "description": "配列の各要素を別々の結果として出力します。", "filter": ".[]", "input": "[1,2,3]", "output": "1\n2\n3\n", "mode": "json", "flags": ["-c"]}, {"category": "抽出", "title": "{id, name}", "description": "同名のキーを取り出し、新しいオブジェクトを作ります。", "filter": "{id, name}", "input": "{\"id\":1,\"name\":\"花\",\"age\":20}", "output": "{\"id\":1,\"name\":\"花\"}\n", "mode": "json", "flags": ["-c"]}, {"category": "抽出", "title": "[.[] | .name]", "description": "各要素のnameを取り出し、明示的に配列へまとめます。", "filter": "[.[] | .name]", "input": "[{\"name\":\"花\"},{\"name\":\"空\"}]", "output": "[\"花\",\"空\"]\n", "mode": "json", "flags": ["-c"]}, {"category": "絞り込み", "title": "select", "description": "条件がtrueとなる値だけを通します。", "filter": ".[] | select(.age >= 20)", "input": "[{\"age\":18},{\"age\":25}]", "output": "{\"age\":25}\n", "mode": "json", "flags": ["-c"]}, {"category": "変換", "title": "map", "description": "配列の各要素を変換し、結果を配列にします。", "filter": "map(. * 2)", "input": "[1,2,3]", "output": "[2,4,6]\n", "mode": "json", "flags": ["-c"]}, {"category": "集計", "title": "length", "description": "配列の要素数。文字列なら文字数、オブジェクトならキー数です。", "filter": "length", "input": "[1,2,3]", "output": "3\n", "mode": "json", "flags": ["-c"]}, {"category": "集計", "title": "add", "description": "配列の値を加算。文字列なら連結、空配列ならnullです。", "filter": "add", "input": "[1,2,3]", "output": "6\n", "mode": "json", "flags": ["-c"]}, {"category": "集計", "title": "group_by", "description": "指定した値で並べ替えてグループ化します。", "filter": "group_by(.kind)", "input": "[{\"kind\":\"b\"},{\"kind\":\"a\"},{\"kind\":\"b\"}]", "output": "[[{\"kind\":\"a\"}],[{\"kind\":\"b\"},{\"kind\":\"b\"}]]\n", "mode": "json", "flags": ["-c"]}, {"category": "並べ替え", "title": "sort_by", "description": "キーの値で昇順に並べ替えます。", "filter": "sort_by(.score)", "input": "[{\"score\":3},{\"score\":1}]", "output": "[{\"score\":1},{\"score\":3}]\n", "mode": "json", "flags": ["-c"]}, {"category": "並べ替え", "title": "reverse", "description": "配列の順序を反転します。", "filter": "reverse", "input": "[1,2,3]", "output": "[3,2,1]\n", "mode": "json", "flags": ["-c"]}, {"category": "並べ替え", "title": "unique_by", "description": "キーの値で重複を除き、その値の順に並べます。", "filter": "unique_by(.id)", "input": "[{\"id\":2},{\"id\":1},{\"id\":2}]", "output": "[{\"id\":1},{\"id\":2}]\n", "mode": "json", "flags": ["-c"]}, {"category": "条件・欠損", "title": "if … then … else … end", "description": "jqではfalseとnullだけが偽です。0や空文字も真になります。", "filter": "if . >= 20 then \"成人\" else \"未成年\" end", "input": "18", "output": "\"未成年\"\n", "mode": "json", "flags": ["-c"]}, {"category": "条件・欠損", "title": "//", "description": "左辺がfalseまたはnullのとき、または結果を生成しないときに代替値を出力します。", "filter": "map(. // \"代替\")", "input": "[null,false,0,\"\"]", "output": "[\"代替\",\"代替\",0,\"\"]\n", "mode": "json", "flags": ["-c"]}, {"category": "条件・欠損", "title": "has", "description": "キーが存在するか調べます。値がnullでも存在します。", "filter": "has(\"name\")", "input": "{\"name\":null}", "output": "true\n", "mode": "json", "flags": ["-c"]}, {"category": "条件・欠損", "title": "?", "description": "直前の式のエラーを抑制します（try式の省略形）。不正JSONや構文エラーを修復せず、式全体のすべての問題を解決するものでもありません。", "filter": ".[] | .name?", "input": "[{\"name\":\"花\"},1]", "output": "\"花\"\n", "mode": "json", "flags": ["-c"]}, {"category": "文字列", "title": "contains", "description": "文字列が部分文字列を含むか調べます。配列・オブジェクトにも包含の意味で使えます。", "filter": "contains(\"cat\")", "input": "\"a cat naps\"", "output": "true\n", "mode": "json", "flags": ["-c"]}, {"category": "文字列", "title": "test", "description": "正規表現に一致するか調べます。", "filter": "test(\"^a\"; \"i\")", "input": "\"Apple\"", "output": "true\n", "mode": "json", "flags": ["-c"]}, {"category": "文字列", "title": "split", "description": "区切り文字列で分割して配列にします。", "filter": "split(\",\")", "input": "\"a,b,c\"", "output": "[\"a\",\"b\",\"c\"]\n", "mode": "json", "flags": ["-c"]}, {"category": "文字列", "title": "join", "description": "配列の文字列を区切り文字で連結します。", "filter": "join(\" / \")", "input": "[\"花\",\"空\"]", "output": "\"花 / 空\"\n", "mode": "json", "flags": ["-c"]}, {"category": "オブジェクト", "title": "keys", "description": "オブジェクトのキーをソートして配列にします。", "filter": "keys", "input": "{\"z\":1,\"a\":2}", "output": "[\"a\",\"z\"]\n", "mode": "json", "flags": ["-c"]}, {"category": "オブジェクト", "title": "to_entries", "description": "キーと値をkey/valueオブジェクトの配列にします。", "filter": "to_entries", "input": "{\"a\":1,\"b\":2}", "output": "[{\"key\":\"a\",\"value\":1},{\"key\":\"b\",\"value\":2}]\n", "mode": "json", "flags": ["-c"]}, {"category": "オブジェクト", "title": "from_entries", "description": "key/valueオブジェクトの配列からオブジェクトを作ります。", "filter": "from_entries", "input": "[{\"key\":\"a\",\"value\":1}]", "output": "{\"a\":1}\n", "mode": "json", "flags": ["-c"]}, {"category": "ストリーム", "title": "JSONL", "description": "非空行ごとに独立したJSON値。通常のフィルターは各入力に順次適用されます。空行は無視します。", "filter": ".id", "input": "{\"id\":1}\n\n{\"id\":2}", "output": "1\n2\n", "mode": "jsonl", "flags": ["-c"]}, {"category": "ストリーム", "title": "inputs", "description": "残りの入力ストリームを消費します。最初の入力はすでに現在の値なので、inputsだけでは含まれません。", "filter": "[., inputs]", "input": "1\n2\n3", "output": "[1,2,3]\n", "mode": "jsonl", "flags": ["-c"]}, {"category": "ストリーム", "title": "inputsで集計", "description": "最初の値を初期値にし、残りの入力を一つのストリームとして加算します。", "filter": "reduce inputs as $n (. ; . + $n)", "input": "1\n2\n3", "output": "6\n", "mode": "jsonl", "flags": ["-c"]}, {"category": "ストリーム", "title": "-s slurp", "description": "すべての入力を配列へ読み込んでから一度だけフィルターを適用します。inputsは残りの入力を逐次消費する点が異なります。", "filter": "add", "input": "1\n2\n3", "output": "6\n", "mode": "jsonl", "flags": ["-s", "-c"]}, {"category": "出力", "title": "-r raw", "description": "文字列の引用符とJSONエスケープを外します。改行・前後の空白もそのまま出力します。", "filter": ".[]", "input": "[\"  花  \",\"空\\n海\"]", "output": "  花  \n空\n海\n", "mode": "json", "flags": ["-r"]}, {"category": "出力", "title": "-c compact", "description": "整形用の改行・インデントを省きます。複数結果は別々の行に出力します。", "filter": ".[]", "input": "[{\"a\":1},{\"b\":2}]", "output": "{\"a\":1}\n{\"b\":2}\n", "mode": "json", "flags": ["-c"]}]