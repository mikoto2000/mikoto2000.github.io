{
  "routes": [
    {
      "route": "/*",
      "methods": [
        "get",
        "head",
        "post",
        "put",
        "delete",
        "connect",
        "options",
        "trace",
        "patch"
      ],
      "rewrite": "/.auth/login/aad",
      "redirect": "/",
      "statusCode": 401,
      "allowedRoles": [
        "authenticated"
      ]
    }
  ]
}